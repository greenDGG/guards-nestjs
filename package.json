{
  "name": "guard-nest",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Colección de guards NestJS de referencia — copia el guard que necesites a tu proyecto",
  "author": "Guard Project",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "precommit": "npm run lint && npm run format",
    "test:normal": "ts-node scripts/test-normal.ts",
    "test:bot": "ts-node scripts/test-bot.ts",
    "test:rate-limit": "ts-node scripts/test-rate-limit.ts",
    "test:web3": "ts-node scripts/test-web3.ts",
    "test:signature": "ts-node scripts/test-signature.ts",
    "test:idempotency": "ts-node scripts/test-idempotency.ts",
    "test:nonce": "ts-node scripts/test-nonce.ts",
    "test:concurrency": "ts-node scripts/test-concurrency.ts",
    "test:api-key": "ts-node scripts/test-api-key.ts",
    "generate:api-key": "ts-node scripts/generate-api-key.ts",
    "test:basic-auth": "ts-node scripts/test-basic-auth.ts",
    "test:jwt": "ts-node scripts/test-jwt.ts",
    "test:ownership": "ts-node scripts/test-ownership.ts",
    "test:roles": "ts-node scripts/test-roles.ts",
    "test:permissions": "ts-node scripts/test-permissions.ts",
    "test:mfa": "ts-node scripts/test-mfa.ts",
    "test:subscription": "ts-node scripts/test-subscription.ts",
    "test:tenant": "ts-node scripts/test-tenant.ts",
    "test:time-based": "ts-node scripts/test-time-based.ts",
    "test:fingerprint": "ts-node scripts/test-fingerprint.ts",
    "test:geo": "ts-node scripts/test-geo.ts",
    "test:adaptive": "ts-node scripts/test-adaptive.ts",
    "test:circuit": "ts-node scripts/test-circuit.ts",
    "test:sliding-window": "ts-node scripts/test-sliding-window.ts",
    "test:content-type": "ts-node scripts/test-content-type.ts",
    "test:cors": "ts-node scripts/test-cors.ts",
    "test:https-only": "ts-node scripts/test-https-only.ts",
    "test:ip": "ts-node scripts/test-ip.ts",
    "test:request-size": "ts-node scripts/test-request-size.ts"
  },
  "keywords": ["nestjs", "guards", "jwt", "roles", "permissions", "authentication", "authorization"],
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
